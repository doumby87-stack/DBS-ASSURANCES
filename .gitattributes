# Fins de ligne Unix partout : les scripts shell et SQL fonctionnent quel que soit le poste
* text=auto eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.command text eol=lf
# Scripts Windows (demo/*.bat) : fins de ligne Windows, que l'invite de commandes lit sans surprise
*.bat text eol=crlf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
*.pdf binary
