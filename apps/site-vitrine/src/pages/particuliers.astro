---
import AppelFinal from "../composants/AppelFinal.astro";
import BlocOffre from "../composants/BlocOffre.astro";
import EntetePage from "../composants/EntetePage.astro";
import Faq from "../composants/Faq.astro";
import Icone from "../composants/Icone.astro";
import { question } from "../donnees/faq";
import { offresPour } from "../donnees/offres";
import Base from "../mises-en-page/Base.astro";

const offres = offresPour("particuliers");
const questions = ["auto-obligatoire", "documents-devis-auto", "attestation-digitale", "arnaques", "rappels"].map(question);
---
<Base
  titre="Assurances pour les particuliers : auto, moto, habitation"
  description="Assurance automobile et moto, multirisque habitation, responsabilité civile et individuelle accident à Abidjan, souscrites auprès de SanlamAllianz Côte d'Ivoire. Devis gratuit."
>
  <EntetePage surtitre="Particuliers" titre="Votre véhicule, votre logement et votre famille, bien assurés." page="Particuliers">
    <p>Nous vous présentons les formules SanlamAllianz adaptées à votre situation, avec des garanties expliquées simplement, et nous vous prévenons avant chaque échéance.</p>
    <ul class="raccourcis" slot="raccourcis">
      {offres.map((o) => <li><a href={`#${o.id}`}><Icone nom={o.icone} />{o.titre}</a></li>)}
    </ul>
  </EntetePage>

  <section class="section">
    <div class="conteneur offres">
      {offres.map((offre) => <BlocOffre offre={offre} />)}
    </div>
  </section>

  <section class="section section--sable" aria-labelledby="titre-faq">
    <div class="conteneur faq-grille">
      <div>
        <p class="surtitre">Questions fréquentes</p>
        <h2 id="titre-faq">Avant de vous assurer</h2>
        <a class="lien-fleche" href="/questions-frequentes/">Toutes les questions <Icone nom="fleche" /></a>
      </div>
      <Faq questions={questions} />
    </div>
  </section>

  <AppelFinal titre="Un devis pour votre voiture, votre moto ou votre logement ?" />
</Base>
