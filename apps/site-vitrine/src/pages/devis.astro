---
import EntetePage from "../composants/EntetePage.astro";
import Icone from "../composants/Icone.astro";
import { AGENCE, LIEN_EMAIL, LIEN_TELEPHONE, lienWhatsApp } from "../donnees/agence";
import { AUTRE_BESOIN, OFFRES } from "../donnees/offres";
import Base from "../mises-en-page/Base.astro";

const choix = [
  ...OFFRES.map((o) => ({ id: o.id, titre: o.titre, icone: o.icone, aPreciser: o.aPreciser })),
  { id: AUTRE_BESOIN.id, titre: AUTRE_BESOIN.titre, icone: "bulle" as const, aPreciser: AUTRE_BESOIN.aPreciser },
];
// Textes d'aide, lus par le script du formulaire
const aides = Object.fromEntries(choix.map((c) => [c.id, c.aPreciser]));
const coordonnees = { whatsapp: AGENCE.whatsapp, email: AGENCE.email };
---
<Base
  titre="Demander un devis d'assurance gratuit"
  description="Devis gratuit et sans engagement pour votre assurance auto, moto, habitation, flotte, multirisque professionnelle ou chantier, auprès de SanlamAllianz Côte d'Ivoire."
>
  <noscript slot="tete"><link rel="stylesheet" href="/styles/sans-js.css" /></noscript>
  <EntetePage surtitre="Devis gratuit" titre="Votre devis en trois étapes." page="Devis">
    <p>Dites-nous ce que vous voulez assurer : un conseiller de l'agence vous répond avec une cotation SanlamAllianz. Le devis est gratuit et sans engagement.</p>
  </EntetePage>

  <section class="section">
    <div class="conteneur devis">
      <form class="formulaire" id="formulaire-devis" novalidate data-aides={JSON.stringify(aides)} data-coordonnees={JSON.stringify(coordonnees)}>
        <ol class="progression" data-progression>
          <li aria-current="step"><span class="visuellement-cache">Étape 1 sur 3 : </span>Votre besoin</li>
          <li><span class="visuellement-cache">Étape 2 sur 3 : </span>Les détails</li>
          <li><span class="visuellement-cache">Étape 3 sur 3 : </span>Vos coordonnées</li>
        </ol>

        <noscript>
          <div class="sans-js">
            <h2 class="h3">Ce formulaire a besoin de JavaScript</h2>
            <p>Il prépare votre message dans votre navigateur. Sans lui, contactez-nous directement : un conseiller prend votre demande par téléphone, WhatsApp ou e-mail.</p>
            <div class="sans-js__actions">
              <a class="bouton bouton--principal" href={LIEN_TELEPHONE}>Appeler le {AGENCE.telephone.affichage}</a>
              <a class="bouton bouton--whatsapp" href={lienWhatsApp("Bonjour DBS-ASSURANCES, je souhaite un devis.")}>Écrire sur WhatsApp</a>
              <a class="bouton bouton--contour" href={LIEN_EMAIL}>{AGENCE.email}</a>
            </div>
          </div>
        </noscript>

        <fieldset class="etape-formulaire" data-etape="1" tabindex="-1">
          <legend>Que souhaitez-vous assurer ?</legend>
          <p class="etape-formulaire__aide">Choisissez l'assurance qui correspond le mieux à votre besoin.</p>
          <ul class="choix" role="list">
            {choix.map((c) => (
              <li><label><input type="radio" name="assurance" value={c.id} required aria-describedby="erreur-assurance" /><Icone nom={c.icone} />{c.titre}</label></li>
            ))}
          </ul>
          <p class="champ__erreur" id="erreur-assurance" aria-live="polite"></p>

          <fieldset class="champ groupe">
            <legend class="champ__libelle">Vous êtes</legend>
            <ul class="choix choix--profil" role="list">
              <li><label><input type="radio" name="profil" value="Particulier" checked /><Icone nom="personne" />Un particulier</label></li>
              <li><label><input type="radio" name="profil" value="Professionnel" /><Icone nom="boutique" />Un professionnel</label></li>
              <li><label><input type="radio" name="profil" value="Entreprise" /><Icone nom="immeuble" />Une entreprise</label></li>
            </ul>
          </fieldset>
          <div class="formulaire__actions">
            <button class="bouton bouton--principal bouton--grand" type="button" data-suivant>Continuer <Icone nom="fleche" /></button>
          </div>
        </fieldset>

        <fieldset class="etape-formulaire" data-etape="2" tabindex="-1" hidden>
          <legend>Parlez-nous de votre besoin</legend>
          <p class="etape-formulaire__aide">Quelques détails suffisent : nous vous rappellerons pour le reste.</p>
          <div class="champ">
            <label for="champ-besoin">Votre besoin <span class="champ__facultatif">(facultatif)</span></label>
            <textarea class="saisie" id="champ-besoin" name="besoin" rows="5" maxlength="1500" placeholder="Décrivez votre besoin en quelques mots…" aria-describedby="aide-besoin"></textarea>
            <p class="champ__aide" id="aide-besoin" data-aide-besoin>Précisez ce qui vous paraît utile.</p>
          </div>
          <div class="champ">
            <label for="champ-commune">Commune ou ville <span class="champ__facultatif">(facultatif)</span></label>
            <input class="saisie" id="champ-commune" name="commune" type="text" maxlength="80" autocomplete="address-level2" placeholder="Yopougon, Cocody, Bouaké…" />
          </div>
          <div class="formulaire__actions">
            <button class="bouton bouton--contour" type="button" data-precedent>Retour</button>
            <button class="bouton bouton--principal bouton--grand" type="button" data-suivant>Continuer <Icone nom="fleche" /></button>
          </div>
        </fieldset>

        <fieldset class="etape-formulaire" data-etape="3" tabindex="-1" hidden>
          <legend>Comment vous joindre ?</legend>
          <p class="etape-formulaire__aide">Les champs marqués d'un astérisque (*) sont obligatoires.</p>
          <div class="recapitulatif" data-recapitulatif hidden></div>
          <div class="grille-2">
            <div class="champ">
              <label for="champ-nom">Nom et prénoms ou raison sociale *</label>
              <input class="saisie" id="champ-nom" name="nom" type="text" maxlength="120" autocomplete="name" required aria-describedby="erreur-nom" />
              <p class="champ__erreur" id="erreur-nom"></p>
            </div>
            <div class="champ">
              <label for="champ-telephone">Téléphone *</label>
              <input class="saisie" id="champ-telephone" name="telephone" type="tel" inputmode="tel" maxlength="25" autocomplete="tel" placeholder="07 00 00 00 00" required aria-describedby="erreur-telephone" />
              <p class="champ__erreur" id="erreur-telephone"></p>
            </div>
          </div>
          <div class="champ">
            <label for="champ-email">E-mail <span class="champ__facultatif">(facultatif)</span></label>
            <input class="saisie" id="champ-email" name="email" type="email" maxlength="254" autocomplete="email" aria-describedby="erreur-email" />
            <p class="champ__erreur" id="erreur-email"></p>
          </div>
          <label class="case">
            <input type="checkbox" name="consentement" required aria-describedby="erreur-consentement" />
            <span>J'accepte que {AGENCE.nom} utilise ces informations pour répondre à ma demande. <a href="/mentions-legales/#donnees">En savoir plus</a></span>
          </label>
          <p class="champ__erreur" id="erreur-consentement"></p>
          <div class="formulaire__actions">
            <button class="bouton bouton--contour" type="button" data-precedent>Retour</button>
            <button class="bouton bouton--whatsapp bouton--grand" type="submit" name="canal" value="whatsapp"><Icone nom="whatsapp" />Envoyer sur WhatsApp</button>
          </div>
          <p class="formulaire__note">
            <Icone nom="courriel" />
            <span>Vous préférez l'e-mail ? <button class="lien-bouton" type="submit" name="canal" value="email">Envoyer ma demande par e-mail</button></span>
          </p>
          <p class="formulaire__note"><Icone nom="cadenas" /><span>Rien n'est enregistré sur ce site : votre demande nous parvient uniquement quand vous l'envoyez depuis WhatsApp ou votre messagerie.</span></p>
        </fieldset>
        <p class="etat-envoi" role="status" aria-live="polite" data-statut-envoi></p>
      </form>

      <aside class="aside-devis" aria-label="Ce qui se passe ensuite">
        <div class="carte">
          <h2 class="h3">Et ensuite ?</h2>
          <ol class="liste-losanges">
            <li>Un conseiller étudie votre demande et vous rappelle si un détail manque.</li>
            <li>Vous recevez une cotation SanlamAllianz, avec les garanties expliquées.</li>
            <li>Vous décidez, sans engagement. Le contrat prend effet au paiement de la prime.</li>
          </ol>
        </div>
        <div class="carte">
          <h2 class="h3">Vous préférez parler à quelqu'un ?</h2>
          <a class="bouton bouton--contour" href={LIEN_TELEPHONE}><Icone nom="telephone" />{AGENCE.telephone.affichage}</a>
          <a class="bouton bouton--whatsapp" href={lienWhatsApp("Bonjour DBS-ASSURANCES, je souhaite un devis.")} target="_blank" rel="noopener noreferrer"><Icone nom="whatsapp" />Discuter sur WhatsApp</a>
        </div>
      </aside>
    </div>
  </section>

  <script>
    import "../scripts/devis";
  </script>
</Base>
