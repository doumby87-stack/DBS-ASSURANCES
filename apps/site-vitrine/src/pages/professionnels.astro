---
import AppelFinal from "../composants/AppelFinal.astro";
import BlocOffre from "../composants/BlocOffre.astro";
import EntetePage from "../composants/EntetePage.astro";
import Faq from "../composants/Faq.astro";
import Icone from "../composants/Icone.astro";
import { question } from "../donnees/faq";
import { lienDevis, OFFRES } from "../donnees/offres";
import Base from "../mises-en-page/Base.astro";

const parId = (ids: string[]) => ids.map((id) => OFFRES.find((o) => o.id === id)!);
const activite = parId(["multirisque_professionnelle", "incendie_risques_divers", "responsabilite_civile", "individuelle_accident", "transport_marchandises"]);
const surMesure = parId(["chantier_construction", "industrie_bris_de_machines", "agricole", "evenementiel"]);
const questions = ["appel-offres", "flotte", "paiement", "debut-couverture"].map(question);
---
<Base
  titre="Assurances pour les professionnels et les entreprises"
  description="Multirisque professionnelle, incendie, responsabilité civile, transport de marchandises, chantiers, industrie, agriculture et événementiel : des garanties SanlamAllianz étudiées pour votre activité."
>
  <EntetePage surtitre="Professionnels et entreprises" titre="Vos locaux, votre activité et vos projets, couverts sur mesure." page="Professionnels">
    <p>Commerçants, artisans, PME, entreprises de travaux : nous étudions vos risques, vous transmettons le bon questionnaire SanlamAllianz quand il le faut, et suivons votre dossier jusqu'à la proposition.</p>
    <ul class="raccourcis" slot="raccourcis">
      <li><a href="#activite"><Icone nom="boutique" />Votre activité</a></li>
      <li><a href="#sur-mesure"><Icone nom="chantier" />Chantiers, industrie, agriculture</a></li>
      <li><a href="/flottes/"><Icone nom="camion" />Vos véhicules et votre flotte</a></li>
    </ul>
  </EntetePage>

  <section class="section" aria-labelledby="activite">
    <div class="conteneur">
      <div class="section__tete">
        <p class="surtitre">Au quotidien</p>
        <h2 id="activite">Protéger votre activité</h2>
      </div>
      <div class="offres">
        {activite.map((offre) => <BlocOffre offre={offre} />)}
      </div>
    </div>
  </section>

  <section class="section section--bleu" aria-labelledby="sur-mesure">
    <div class="conteneur">
      <div class="section__tete">
        <p class="surtitre">Risques d'entreprise</p>
        <h2 id="sur-mesure">Chantiers, industrie, agriculture, événements : étudiés sur questionnaire.</h2>
        <p class="chapeau">Pour ces risques, SanlamAllianz établit sa proposition à partir d'un questionnaire de souscription. Nous vous le transmettons, vous aidons à le remplir et suivons l'étude de votre dossier.</p>
      </div>
      <div class="grille-cartes">
        {surMesure.map((o) => (
          <article class="carte" id={o.id}>
            <div class="carte__tete"><span class="carte__icone"><Icone nom={o.icone} /></span><h3>{o.titre}</h3></div>
            <ul class="liste-losanges">{o.garanties.map((g) => <li>{g}</li>)}</ul>
            <a class="lien-fleche" href={lienDevis(o.id)}>Demander le questionnaire <span class="visuellement-cache">{o.titre}</span><Icone nom="fleche" /></a>
          </article>
        ))}
      </div>
      <div class="encadre encadre--or">
        <Icone nom="document" />
        <p><strong>Un appel d'offres exige une attestation d'assurance ?</strong> Envoyez-nous le cahier des charges : nous vous indiquons les garanties à souscrire et préparons le dossier avec vous. <a href={lienDevis("chantier_construction")}>Nous consulter</a></p>
      </div>
    </div>
  </section>

  <section class="section section--sable" aria-labelledby="titre-faq">
    <div class="conteneur faq-grille">
      <div>
        <p class="surtitre">Questions fréquentes</p>
        <h2 id="titre-faq">Les questions des entreprises</h2>
        <a class="lien-fleche" href="/questions-frequentes/">Toutes les questions <Icone nom="fleche" /></a>
      </div>
      <Faq questions={questions} />
    </div>
  </section>

  <AppelFinal titre="Parlez-nous de votre activité." />
</Base>
