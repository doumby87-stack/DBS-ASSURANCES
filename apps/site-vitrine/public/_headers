# En-têtes de sécurité HTTP du site vitrine.
# Lus automatiquement par Netlify et Cloudflare Pages (même syntaxe).
# Explications : docs/securite/en-tetes-http.md
#
# Le site n'a aucun script ni style inline (construction par Astro, ADR 0008) : script-src et style-src
# n'autorisent que les fichiers du site.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
