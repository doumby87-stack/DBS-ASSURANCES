{
  "name": "@dbs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de DBS-ASSURANCES : authentification du personnel, droits, règles métier",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/serveur.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/serveur.js",
    "premier-acces": "node dist/outils/premier-acces.js",
    "verifier-types": "tsc --noEmit",
    "test:unitaires": "vitest run --project unitaires",
    "test:integration": "vitest run --project integration",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
