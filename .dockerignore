# Contexte de construction de la démonstration (demo/Dockerfile) : jamais de secrets ni de dépendances de l'hôte
.git
node_modules
apps/*/node_modules
apps/*/dist
apps/*/dist-avec-api
apps/*/.astro
apps/*/test-results
apps/*/playwright-report
apps/*/.e2e
**/*.tsbuildinfo
.env
.env.*
!.env.example
# Journaux (demo/journal-demarrage.log) : ils changeraient le contexte et relanceraient toute la construction
*.log
