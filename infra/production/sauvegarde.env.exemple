# Accès au stockage hors site des sauvegardes (rclone, https://rclone.org/docs/#config-file), SANS VALEURS.
# Copiez ce fichier en infra/production/sauvegarde.env, remplissez-le, puis : chmod 600 infra/production/sauvegarde.env
# Exemple pour un stockage compatible S3 (OVHcloud, Scaleway, Backblaze…), avec SAUVEGARDE_DESTINATION=horssite:<seau>.
# Activez sur le seau le verrouillage des objets (écriture unique, « object lock ») et la conservation : 30 jours
# pour les sauvegardes quotidiennes, puis 12 mois. La clé d'accès ne doit permettre que l'écriture (pas la suppression).
RCLONE_CONFIG_HORSSITE_TYPE=s3
RCLONE_CONFIG_HORSSITE_PROVIDER=
RCLONE_CONFIG_HORSSITE_ENDPOINT=
RCLONE_CONFIG_HORSSITE_REGION=
RCLONE_CONFIG_HORSSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_HORSSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_HORSSITE_NO_CHECK_BUCKET=true

# Facultatif, conseillé : adresse « battement de cœur » d'un service de surveillance (infra/surveillance/README.md),
# appelée chaque nuit quand la sauvegarde est réussie, copiée hors site et le journal d'audit intact
SAUVEGARDE_SIGNAL_URL=
