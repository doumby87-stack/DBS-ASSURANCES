# Réglages du serveur pour Docker Compose (infra/production/compose.yml), SANS VALEURS.
# Copiez ce fichier en infra/production/.env, remplissez-le, puis : chmod 600 infra/production/.env
# Mots de passe : tirés au hasard avec « openssl rand -hex 32 » (64 caractères, sans signe qui gênerait dans l'adresse
# de connexion DATABASE_URL), rangés aussi dans le coffre-fort.

# Adresses (le DNS de chacune doit pointer vers ce serveur avant le premier démarrage)
DOMAINE_GESTION=
DOMAINE_CLIENT=
# E-mail de contact pour les certificats HTTPS (Let's Encrypt)
ACME_EMAIL=
# Toujours vide en production (« tls internal » seulement pour un essai sur un poste)
TLS_LOCAL=

# Base de données : laissez PGHOST vide pour la base locale (profil base-locale), ou mettez l'adresse de la base gérée
PGHOST=
PGPORT=
PGDATABASE=
# Superutilisateur de la base locale (profil base-locale), ou compte d'administration de la base gérée (PGUSER_ADMIN)
POSTGRES_PASSWORD=
PGUSER_ADMIN=
# Comptes de l'application (database/initialisation/01_roles_et_base.sql)
PROPRIETAIRE_MOT_DE_PASSE_BASE=
APPLICATION_MOT_DE_PASSE_BASE=
SAUVEGARDE_MOT_DE_PASSE_BASE=

# Sauvegardes (infra/sauvegardes) : clé PUBLIQUE age (age1…) ; la clé privée ne va jamais sur ce serveur
SAUVEGARDE_CLE_PUBLIQUE=
# Heure de la sauvegarde quotidienne, heure d'Abidjan (02:00 par défaut)
SAUVEGARDE_HEURE=
# Destination rclone hors site, par exemple horssite:dbs-sauvegardes (accès dans sauvegarde.env)
SAUVEGARDE_DESTINATION=

# Version des images (étiquette libre, par exemple la date du déploiement)
VERSION=
