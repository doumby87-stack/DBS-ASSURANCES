# Serveur web de production (infra/production) : HTTPS automatique (Let's Encrypt ; certificats internes pour les
# noms en .localhost des essais, infra/tests/production.sh), en-têtes de sécurité de
# docs/securite/en-tetes-http.md, back-office et espace client servis en fichiers statiques, API derrière /api
# sur chacun des deux domaines (même origine : ni CORS, ni cookie partagé). Variables : DOMAINE_GESTION,
# DOMAINE_PORTAIL, ADRESSE_ACME (compose.yml).

{
	email {$ADRESSE_ACME}
	servers {
		# Pare-feu applicatif ou répartiteur placé devant Caddy (ADR 0017) : ses plages d'adresses, séparées par des
		# espaces (PROXYS_AMONT). Vide : Caddy est la façade et ignore tout X-Forwarded-For reçu.
		trusted_proxies static {$PROXYS_AMONT}
	}
}

(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()"
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Cross-Origin-Resource-Policy same-origin
		X-Permitted-Cross-Domain-Policies none
		# Aucun nom de logiciel annoncé
		-Server
		-Via
	}
}

# Une application : ses fichiers (argument : le dossier) et l'API
(application) {
	import securite
	encode zstd gzip
	# Demandes du site avec leurs pièces jointes (quatre fichiers en base64) : 32 Mo au plus
	request_body {
		max_size 32MB
	}
	handle_path /api/* {
		# L'API lit l'adresse du visiteur dans X-Forwarded-For (PROXYS_DE_CONFIANCE : 1 intermédiaire, Caddy ; 2 avec
		# un pare-feu applicatif devant) pour ses limites et son journal de sécurité
		reverse_proxy api:3000
	}
	handle {
		root * {args[0]}
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		# Les fichiers construits par Vite portent une empreinte dans leur nom : cache long ; le reste, revérifié
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format json
	}
}

{$DOMAINE_GESTION} {
	import application /srv/gestion
}

{$DOMAINE_PORTAIL} {
	import application /srv/portail
}
