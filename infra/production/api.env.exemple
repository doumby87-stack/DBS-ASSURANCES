# Secrets et réglages de l'API en production (apps/api/README.md), SANS VALEURS.
# Copiez ce fichier en infra/production/api.env, remplissez-le, puis : chmod 600 infra/production/api.env
# HOST, PORT, PROXYS_DE_CONFIANCE et ANTIVIRUS_ADRESSE sont fixés par compose.yml.

# Connexion avec le compte dbs_application, par exemple :
#   postgresql://dbs_application:MOT_DE_PASSE@base:5432/dbs                     (base locale, réseau interne)
#   postgresql://dbs_application:MOT_DE_PASSE@hote:5432/dbs?sslmode=verify-full  (base gérée)
DATABASE_URL=
# 32 octets en base64 (openssl rand -base64 32) ; copie de secours scellée, hors ligne : la perdre oblige à
# réinitialiser l'accès de tout le personnel
CLE_CHIFFREMENT_DONNEES=
# https://<DOMAINE_GESTION>
URL_BACK_OFFICE=
# https://<DOMAINE_CLIENT> (espace client) ; vide tant que l'espace client n'est pas ouvert
URL_PORTAIL=
# Adresse du site vitrine, seulement après la déclaration à l'ARTCI (ADR 0009)
URL_SITE_VITRINE=
NIVEAU_JOURNAL=

# Relances et codes de l'espace client par WhatsApp (ADR 0007)
RELANCES_ACTIVES=
RELANCES_HEURES_ENVOI=
WHATSAPP_JETON=
WHATSAPP_IDENTIFIANT_NUMERO=
WHATSAPP_SECRET_APPLICATION=
WHATSAPP_JETON_VERIFICATION=
WHATSAPP_VERSION_API=

# Paiement en ligne (prestataire réel à choisir, ADR 0012)
PAIEMENT_PRESTATAIRE=
PAIEMENT_MONTANT_MAX=

# Lecture automatique des documents (ADR 0015) : local
LECTURE_PRESTATAIRE=
LECTURE_MODELE=
LECTURE_OLLAMA_ADRESSE=
