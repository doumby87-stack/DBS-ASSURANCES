# Variables d'environnement, SANS VALEURS.
# Copiez ce fichier en .env sur votre machine (jamais envoyé dans le dépôt) et remplissez-le
# avec des valeurs de développement. En production, les valeurs viennent du gestionnaire de
# secrets de l'hébergeur. Voir docs/securite/gestion-des-secrets.md

# --- Base de données de développement (infra/docker/compose.dev.yml) ---
POSTGRES_PASSWORD=

# --- API (apps/api/README.md) ---
# Connexion avec le compte dbs_application, en TLS en production (sslmode=verify-full)
DATABASE_URL=
# Chiffrement des secrets du deuxième facteur et des données très sensibles (AES-256-GCM) :
# 32 octets en base64 (openssl rand -base64 32). La perdre oblige à réinitialiser tous les accès.
CLE_CHIFFREMENT_DONNEES=
# Adresse du back-office : seule origine autorisée à modifier des données
URL_BACK_OFFICE=
# Facultatifs
HOST=
PORT=
PROXYS_DE_CONFIANCE=
VERIFIER_MOTS_DE_PASSE_DIVULGUES=
NIVEAU_JOURNAL=
# Installation du premier gérant uniquement (npm run premier-acces) : compte dbs_proprietaire.
# Ne jamais le laisser dans l'environnement de l'API en fonctionnement.
DATABASE_URL_PROPRIETAIRE=

# --- Espace client (tâche 9) ---
URL_ESPACE_CLIENT=

# --- Paiement Mobile Money (tâche 9) ---
PAIEMENT_CLE_API=
PAIEMENT_IDENTIFIANT_SITE=
PAIEMENT_SECRET_NOTIFICATIONS=

# --- WhatsApp Business et SMS (tâche 6) ---
WHATSAPP_JETON=
WHATSAPP_IDENTIFIANT_NUMERO=
WHATSAPP_SECRET_APPLICATION=
SMS_CLE_API=

# --- Facture normalisée électronique (tâche 12) ---
FNE_CLE_API=
