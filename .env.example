# Variables d'environnement, SANS VALEURS.
# Copiez ce fichier en .env sur votre machine (jamais envoyé dans le dépôt) et remplissez-le
# avec des valeurs de développement. En production, les valeurs viennent du gestionnaire de
# secrets de l'hébergeur. Voir docs/securite/gestion-des-secrets.md

# --- Base de données de développement (infra/docker/compose.dev.yml) ---
POSTGRES_PASSWORD=

# --- API (tâche 3) ---
# Connexion avec le compte dbs_application, en TLS en production (sslmode=verify-full)
DATABASE_URL=
# Signature des sessions : 32 octets aléatoires au moins (openssl rand -base64 32)
SESSION_SECRET=
# Chiffrement des numéros de pièces d'identité (AES-256-GCM) : 32 octets en base64
CLE_CHIFFREMENT_DONNEES=
# Adresse publique du back-office et de l'espace client (cookies, CORS)
URL_BACK_OFFICE=
URL_ESPACE_CLIENT=

# --- Paiement Mobile Money (tâche 9) ---
PAIEMENT_CLE_API=
PAIEMENT_IDENTIFIANT_SITE=
PAIEMENT_SECRET_NOTIFICATIONS=

# --- WhatsApp Business et SMS (tâche 6) ---
WHATSAPP_JETON=
WHATSAPP_IDENTIFIANT_NUMERO=
WHATSAPP_SECRET_APPLICATION=
SMS_CLE_API=

# --- Facture normalisée électronique (tâche 12) ---
FNE_CLE_API=
