# Variables d'environnement, SANS VALEURS.
# Copiez ce fichier en .env sur votre machine (jamais envoyé dans le dépôt) et remplissez-le
# avec des valeurs de développement. En production, les valeurs viennent du gestionnaire de
# secrets de l'hébergeur. Voir docs/securite/gestion-des-secrets.md

# --- Base de données de développement (infra/docker/compose.dev.yml) ---
POSTGRES_PASSWORD=

# --- API (apps/api/README.md) ---
# Connexion avec le compte dbs_application, en TLS en production (sslmode=verify-full)
DATABASE_URL=
# Chiffrement des secrets du deuxième facteur et des données très sensibles (AES-256-GCM) :
# 32 octets en base64 (openssl rand -base64 32). La perdre oblige à réinitialiser tous les accès.
CLE_CHIFFREMENT_DONNEES=
# Adresse du back-office : seule origine autorisée à modifier des données
URL_BACK_OFFICE=
# Adresse du site vitrine (tâche 7, ADR 0009) : ouvre la route publique des demandes de devis à ce seul site.
# À renseigner seulement après la déclaration à l'ARTCI. Vide : le site garde l'envoi par WhatsApp.
URL_SITE_VITRINE=
# Démon ClamAV qui analyse les cartes grises (hôte:port, 3310 par défaut). Obligatoire en production
# dès que URL_SITE_VITRINE est défini.
ANTIVIRUS_ADRESSE=
# Facultatifs
HOST=
PORT=
PROXYS_DE_CONFIANCE=
VERIFIER_MOTS_DE_PASSE_DIVULGUES=
NIVEAU_JOURNAL=
# Installation du premier gérant uniquement (npm run premier-acces) : compte dbs_proprietaire.
# Ne jamais le laisser dans l'environnement de l'API en fonctionnement.
DATABASE_URL_PROPRIETAIRE=

# --- Site vitrine : construction (apps/site-vitrine/LISEZMOI.md), à définir dans Netlify, pas dans l'API ---
# Adresse publique du site (adresses canoniques, aperçus de liens), fournie automatiquement par Netlify
URL_SITE=
# Adresse de l'API qui enregistre les demandes de devis, par exemple https://gestion.exemple.ci/api (tâche 7)
URL_API=

# --- Espace client (tâche 9) ---
URL_ESPACE_CLIENT=

# --- Paiement Mobile Money (tâche 9) ---
PAIEMENT_CLE_API=
PAIEMENT_IDENTIFIANT_SITE=
PAIEMENT_SECRET_NOTIFICATIONS=

# --- Relances automatiques : WhatsApp Business et SMS (tâche 6, apps/api/README.md) ---
# Planificateur toutes les 15 minutes (true / false, false par défaut)
RELANCES_ACTIVES=
# Heures d'envoi, heure d'Abidjan (8-20 par défaut)
RELANCES_HEURES_ENVOI=
# Développement et tests uniquement : rien ne part (refusé en production)
RELANCES_SIMULATION=
# API Cloud de Meta : les quatre ensemble, ou aucune
WHATSAPP_JETON=
WHATSAPP_IDENTIFIANT_NUMERO=
WHATSAPP_SECRET_APPLICATION=
WHATSAPP_JETON_VERIFICATION=
# Facultatif (v23.0 par défaut)
WHATSAPP_VERSION_API=
# Opérateur SMS : à choisir (ADR 0007), pas encore utilisé
SMS_CLE_API=

# --- Facture normalisée électronique (tâche 12) ---
FNE_CLE_API=
